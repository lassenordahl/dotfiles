[user]
	name = lassenordahl
	email = lasseanordahl@gmail.com
[core]
	excludesFile = ~/.config/git/ignore
[pull]
	rebase = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# Machine-specific settings (credential helpers etc.), not tracked
[include]
	path = ~/.gitconfig.local
